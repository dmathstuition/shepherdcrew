# Supabase — where /api/join stores registrations.
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=
# The SERVICE ROLE (secret) key. Server-only — never prefix with NEXT_PUBLIC_
# and never expose it to the browser. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata and Open Graph
NEXT_PUBLIC_SITE_URL=https://theshepherdscrew.org
