# Supabase — registrations (/api/join) and the class portal.
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=
# The SERVICE ROLE (secret) key. Server-only — never prefix with NEXT_PUBLIC_
# and never expose it to the browser. Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Portal secret — signs member session cookies AND hashes access codes.
# Use a long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates all sessions and all existing access codes.
PORTAL_SESSION_SECRET=

# One-time token to create the FIRST admin from the browser at /admin/setup.
# Set this to any long random string, create your admin, then you may remove it
# (setup self-closes once an admin exists). Further admins are added in the
# dashboard's Admins section — no token needed.
ADMIN_SETUP_TOKEN=

# Public site URL, used for metadata and Open Graph
NEXT_PUBLIC_SITE_URL=https://theshepherdscrew.org
